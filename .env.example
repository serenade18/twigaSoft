# Copy to .env.local and adjust.

# API origin for the built site when the API is on another domain, e.g. https://api.example.com
# Leave empty to call /api on the same origin (dev proxy, or a reverse proxy in production).
VITE_API_BASE_URL=

# Dev server only: where `npm run dev` forwards /api requests
API_PROXY_TARGET=http://localhost:8000
